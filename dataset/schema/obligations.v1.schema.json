{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcarius.example/schema/obligations.v1.schema.json",
  "title": "EU digital-compliance obligations dataset v1",
  "type": "object",
  "required": ["schema_version", "generated_on", "row_count", "coverage", "rows"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "generated_from": { "type": "string" },
    "generated_on": { "$ref": "#/$defs/date" },
    "row_count": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": "object",
      "required": [
        "jurisdictions",
        "jurisdiction_count",
        "regimes",
        "confidence_counts",
        "oldest_checked_on",
        "newest_checked_on",
        "rows_with_open_unknowns"
      ],
      "properties": {
        "jurisdictions": { "type": "array", "items": { "$ref": "#/$defs/country" } },
        "jurisdiction_count": { "type": "integer", "minimum": 0 },
        "member_state_jurisdictions": { "type": "array", "items": { "$ref": "#/$defs/country" } },
        "member_state_count": { "type": "integer", "minimum": 0 },
        "supranational_jurisdictions": { "type": "array", "items": { "$ref": "#/$defs/country" } },
        "regimes": { "type": "array", "items": { "type": "string" } },
        "confidence_counts": {
          "type": "object",
          "required": ["verified", "reported", "unknown"],
          "properties": {
            "verified": { "type": "integer", "minimum": 0 },
            "reported": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          }
        },
        "oldest_checked_on": { "$ref": "#/$defs/date" },
        "newest_checked_on": { "$ref": "#/$defs/date" },
        "rows_with_open_unknowns": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "nullableDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "jurisdiction",
        "jurisdiction_name",
        "regime",
        "regime_label",
        "direction",
        "counterparty_scope",
        "bound_party",
        "threshold_type",
        "threshold_value",
        "threshold_currency",
        "threshold_operator",
        "threshold_basis",
        "threshold_period",
        "threshold_definition",
        "format_name",
        "format_version",
        "format_note",
        "mandatory_from",
        "tolerance_ends",
        "tolerance_note",
        "legal_instrument",
        "source_url",
        "source_title",
        "source_type",
        "secondary_source_urls",
        "checked_on",
        "confidence",
        "confidence_note",
        "unknowns",
        "notes"
      ],
      "properties": {
        "obligation_id": { "type": "string", "minLength": 1 },
        "jurisdiction": { "$ref": "#/$defs/country" },
        "jurisdiction_name": { "type": "string", "minLength": 1 },
        "regime": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "regime_label": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["issue", "receive", "report"] },
        "counterparty_scope": {
          "enum": ["b2b", "b2c", "b2g", "b2b-and-b2c", "cross-border-b2b"]
        },
        "bound_party": { "type": "string", "minLength": 1 },
        "threshold_type": {
          "enum": ["none", "turnover", "revenue_or_fees", "headcount", "entity_type"]
        },
        "threshold_value": { "type": ["number", "null"] },
        "threshold_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "threshold_operator": {
          "type": ["string", "null"],
          "enum": ["gt", "gte", "lt", "lte", "between", null]
        },
        "threshold_basis": { "type": ["string", "null"] },
        "threshold_period": { "type": ["string", "null"] },
        "threshold_definition": { "type": ["string", "null"] },
        "format_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Null when the instrument mandates no format at all (Portugal) or when the format was not established in the pass (GR, RO). build.py requires format_note to say which; a null here is a recorded fact, not a missing value."
        },
        "format_version": { "type": ["string", "null"] },
        "format_note": { "type": ["string", "null"] },
        "mandatory_from": { "$ref": "#/$defs/nullableDate" },
        "tolerance_ends": { "$ref": "#/$defs/nullableDate" },
        "tolerance_note": { "type": ["string", "null"] },
        "legal_instrument": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_type": {
          "enum": [
            "statute",
            "tax_authority",
            "official_gazette",
            "eu_legal_act",
            "standards_body",
            "secondary"
          ]
        },
        "secondary_source_urls": { "type": "array", "items": { "type": "string" } },
        "checked_on": { "$ref": "#/$defs/date" },
        "confidence": { "enum": ["verified", "reported", "unknown"] },
        "confidence_note": { "type": ["string", "null"] },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "description": "A sized obligation must carry an operator and a measurement period.",
          "if": {
            "properties": {
              "threshold_type": { "enum": ["turnover", "revenue_or_fees", "headcount"] }
            }
          },
          "then": {
            "properties": {
              "threshold_value": { "type": "number" },
              "threshold_operator": { "type": "string" },
              "threshold_period": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "description": "threshold_type none carries no value or operator.",
          "if": { "properties": { "threshold_type": { "const": "none" } } },
          "then": {
            "properties": {
              "threshold_value": { "type": "null" },
              "threshold_operator": { "type": "null" }
            }
          }
        },
        {
          "description": "A verified row must cite a primary source, not a secondary one.",
          "if": { "properties": { "confidence": { "const": "verified" } } },
          "then": {
            "properties": {
              "source_type": {
                "enum": [
                  "statute",
                  "tax_authority",
                  "official_gazette",
                  "eu_legal_act",
                  "standards_body"
                ]
              }
            }
          }
        }
      ]
    }
  }
}

# Copy to .env and fill in locally. Never commit real values.

# HMAC pepper for API key hashing. Minimum 32 characters; the API refuses to
# start without it. Generate with: openssl rand -hex 32
# Changing this invalidates every existing key.
API_KEY_PEPPER=

# Where the key database lives. Defaults to ./api/data/keys.db (gitignored).
API_DB_PATH=./api/data/keys.db

PORT=8787

# Site build. Only set SITE_INDEXABLE=true once the brand and domain are signed
# off — until then every page is noindex and robots.txt disallows everything.
SITE_URL=https://arcarius-services.github.io
SITE_BASE=/eu-einvoicing-deadlines
SITE_INDEXABLE=false

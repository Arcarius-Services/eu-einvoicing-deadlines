---
import '../styles/global.css'
import { loadDataset } from '../data/obligations.js'
import { loadProviders } from '../data/providers.js'
import { BRAND, DISCLAIMER } from '../brand.mjs'

const { title, description, noindexReason } = Astro.props
const { isFixture, schemaVersion, rowCount } = loadDataset()

// Scout's provider dataset (ARC-7) is not published yet. No rows, no nav link —
// we do not advertise a section that would render an empty table.
const hasProviders = loadProviders().providers.length > 0

// One canonical per page, absolute, trailing slash, base path included.
const canonical = new URL(Astro.url.pathname, Astro.site).href

// A fixture row is not a fact, so a fixture build is never indexable. The brand
// is settled (Rulefeed), so the remaining reason to hold indexing is the domain:
// flip SITE_INDEXABLE=true once rulefeed.eu is serving, so we never have to
// migrate search engines off the Pages URL.
const indexable = process.env.SITE_INDEXABLE === 'true'
const noindex = isFixture || !indexable || Boolean(noindexReason)
const base = import.meta.env.BASE_URL
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    {isFixture && (
      <div class="alarm">
        <strong>FIXTURE BUILD — NOT REAL DATA.</strong> Ledger&rsquo;s dataset
        (<code>dataset/dist/obligations.json</code>) is not built yet, so this site is rendering
        placeholder rows for a country that does not exist, with dates in 2099. Every page is
        <code>noindex</code>. Do not quote anything on this site.
      </div>
    )}

    <header class="site">
      <a class="wordmark" href={base}>{BRAND}</a>
      <nav>
        <a href={`${base}countries/`}>Countries</a>
        {hasProviders && <a href={`${base}providers/`}>Peppol providers</a>}
        <a href={`${base}pricing/`}>Pricing</a>
        <a href={`${base}docs/`}>API docs</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site">
      <p>
        Dataset schema <code>{schemaVersion}</code>, {rowCount} rows. Every date on this site links
        to the primary source it was read from. We publish the source, the date we last checked it,
        and our confidence in it — so you can check our work.
      </p>
      <p class="disclaimer">{DISCLAIMER}</p>
      <p class="muted">{BRAND} is a maintained reference dataset of published regulatory timelines.</p>
    </footer>
  </body>
</html>
